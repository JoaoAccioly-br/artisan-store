#!/usr/bin/env sh
set -eu

# Impede commit acidental de arquivos .env (exceto .env.example)
STAGED_ENV=$(git diff --cached --name-only | grep -E '(^|/)\.env($|\.)' | grep -v '\.env\.example$' || true)
if [ -n "$STAGED_ENV" ]; then
  echo "Erro: tentativa de commit de arquivo .env bloqueada:"
  echo "$STAGED_ENV"
  exit 1
fi

# Verifica formatação Go nos arquivos staged
STAGED_GO=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$STAGED_GO" ]; then
  UNFORMATTED=$(gofmt -l $STAGED_GO)
  if [ -n "$UNFORMATTED" ]; then
    echo "Erro: arquivos Go não formatados com gofmt:"
    echo "$UNFORMATTED"
    echo "Execute 'make fmt' e adicione novamente ao stage."
    exit 1
  fi
fi
