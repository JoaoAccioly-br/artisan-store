# ==========================================
# Banco de Dados (PostgreSQL)
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=doceria
POSTGRES_PASSWORD=doceria_dev_password
POSTGRES_DB=doceria
POSTGRES_SSLMODE=disable

DATABASE_URL=postgres://doceria:doceria_dev_password@localhost:5432/doceria?sslmode=disable

# ==========================================
# API em Go
# ==========================================
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=debug
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,wails://wails

# ==========================================
# Autenticação JWT (trocar em produção!)
# ==========================================
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-dev-only
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Seed do primeiro administrador (executado apenas se não houver usuários)
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@doceria.local
SEED_ADMIN_PASSWORD=Admin#123456

# ==========================================
# Pagamentos (Pix) & Storage
# ==========================================
PAYMENT_PROVIDER=fake
PIX_WEBHOOK_SECRET=change-me-pix-webhook-secret
PIX_RESERVATION_TTL=15m

# Driver de imagens: local (disco) ou s3 (AWS S3 / Cloudflare R2 / MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_URL=http://localhost:8080/uploads
STORAGE_MAX_UPLOAD_BYTES=5242880

# Configurações S3-compatível (obrigatórias quando STORAGE_DRIVER=s3)
STORAGE_S3_ENDPOINT=
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_USE_PATH_STYLE=false
